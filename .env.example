# Turn Dispenser — plantilla de variables de entorno
# Copia este archivo y rellena valores locales:
#   cp .env.example .env
#   # o: cp .env.example .env.local
#
# Nunca commits de .env, .env.local ni .env.production.
# Los defaults de la app coinciden con el comportamiento actual si no defines nada.

# local | production
APP_ENV=local

# Mensajes de depuración en consola/GUI (true/false)
DEBUG=true

# --- Logging (B-02) ---
# Nivel: DEBUG | INFO | WARNING | ERROR
# Si no defines LOG_LEVEL: DEBUG cuando DEBUG=true, INFO cuando DEBUG=false.
# En piloto se recomienda:
# LOG_LEVEL=INFO
# LOG_FILE=logs/turn_dispenser.log
# (sin LOG_FILE: solo consola/stderr; logs/ está en .gitignore)

# --- Playwright / automatización ---
# Headless=false es obligatorio en operación normal: el CAPTCHA de RUNT es manual.
BROWSER_HEADLESS=false

RUNT_URL=https://portalpublico.runt.gov.co/#/consulta-ciudadano-documento/consulta/consulta-ciudadano-documento
SIMIT_URL=https://www.fcm.org.co/simit/#/home-public

RUNT_SLOW_MO_MS=300
SIMIT_SLOW_MO_MS=200

NAVIGATION_TIMEOUT_MS=60000
RUNT_NETWORK_IDLE_TIMEOUT_MS=10000
SIMIT_NETWORK_IDLE_TIMEOUT_MS=15000
SIMIT_RESULTS_TIMEOUT_MS=30000
RUNT_CAPTCHA_TIMEOUT_MS=45000

# --- Supabase / Postgres (D-01/D-02) ---
# Guía: docs/supabase-local.md — esquema: docs/db-schema.md — repositorios: docs/persistencia.md
# Tras `supabase start`, rellena keys con `supabase status` (nunca commits de keys reales).
# La app usa DATABASE_URL (psycopg) para repositorios; no hardcodear passwords.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# Solo scripts/admin / repositorios internos. NUNCA empaquetar en el instalador del operador.
# SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_CONNECT_TIMEOUT_S=10
# true = guardar cada consulta al finalizar (D-03). false = solo mostrar resultados.
PERSISTENCIA_ENABLED=true
# Metadatos opcionales de estación (se guardan en cabecera consultas).
# En piloto rellenar para trazabilidad (ver docs/RUNBOOK_PILOTO.md).
# OPERADOR=operador-piloto
# ESTACION=CRC-PILOTO-1
# APP_VERSION=

# --- Producción (descomentar / rellenar solo fuera del repo) ---
# APP_ENV=production
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
