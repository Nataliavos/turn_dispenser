# Turn Dispenser — plantilla de variables de entorno
# Copia este archivo y rellena valores locales:
#   cp .env.example .env
#   # o: cp .env.example .env.local
#
# Nunca commits de .env, .env.local ni .env.production.
# Los defaults de la app coinciden con el comportamiento actual si no defines nada.

# local | production
APP_ENV=local

# Mensajes de depuración en consola/GUI (true/false)
DEBUG=true

# --- Playwright / automatización ---
# Headless=false es obligatorio en operación normal: el CAPTCHA de RUNT es manual.
BROWSER_HEADLESS=false

RUNT_URL=https://portalpublico.runt.gov.co/#/consulta-ciudadano-documento/consulta/consulta-ciudadano-documento
SIMIT_URL=https://www.fcm.org.co/simit/#/home-public

RUNT_SLOW_MO_MS=300
SIMIT_SLOW_MO_MS=200

NAVIGATION_TIMEOUT_MS=60000
RUNT_NETWORK_IDLE_TIMEOUT_MS=10000
SIMIT_NETWORK_IDLE_TIMEOUT_MS=15000
SIMIT_RESULTS_TIMEOUT_MS=30000
RUNT_CAPTCHA_TIMEOUT_MS=45000

# --- Supabase / Postgres (Fase D — placeholders; aún no se usan en runtime) ---
# Valores locales típicos tras `supabase start` / `supabase status`.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# Solo scripts/admin internos. NUNCA empaquetar en el instalador del operador.
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Producción (descomentar / rellenar solo fuera del repo) ---
# APP_ENV=production
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
